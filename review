#!/bin/sh
# Review an event plan with a model and write the review as JSON.
#
#   ./review <plan.md> <out.json>
#
# Needs no key or setting: the plan is reviewed on the review server, which
# holds the model key, and the result is checked against the plan before it is
# written. REVIEW_LOCAL=1 with OPENROUTER_API_KEY calls the model directly.
# Exit codes: 0 review written, 1 no usable review, 2 usage or setup error,
# 3 model service error. On any non-zero exit, no output file is written.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export TSX_TSCONFIG_PATH="$here/tsconfig.json"
exec "$here/node_modules/.bin/tsx" "$here/src/cli/review.ts" "$@"
